// See all bridge.json configuration options at https://github.com/bridgedotnet/Bridge/wiki/global-configuration
{
  "output": "$(OutDir)/h5/",
  "fileName": "app.js",
  "html": {
    "disabled": false,
    "title": "Mosaik Front-End Recipes"
  },
  "resources": [],
  "cleanOutputFolderBeforeBuildPattern": "*.js|*.css",
  "console": {
    "enabled": false
  },
  "loader": {
    "type": "Global"
  },
  "sourceMap": {
    "enabled": false
  },
  "reflection": {
    "disabled": false
  },
  "generateTypeScript": false,
  "rules": {
    "anonymousType": "Plain",
    "arrayIndex": "Managed",
    "autoProperty": "Plain",
    "boxing": "Managed",
    "externalCast": "Plain",
    "inlineComment": "Plain",
    "integer": "Managed",
    "lambda": "Plain",
    "useShortForms": true
  }
}
