<Project Sdk="Transpose.Build.Target/26.10.7421">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- No LangVersion: the Transpose SDK defaults it to `latest`, which is what tps compiles at. -->
    <NoWarn>CS1998;CA2007</NoWarn>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DefineConstants>Transpose</DefineConstants>
    <RootNamespace>FrontEnd.Recipes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transpose.BCL" Version="26.11.7972" />
    <PackageReference Include="Transpose.Newtonsoft.Json" Version="26.10.7422" />
    <PackageReference Include="Tesserae" Version="2026.11.73601" />
    <PackageReference Include="Curiosity.FrontEnd.API" Version="26.11.8066" />
    <PackageReference Include="Curiosity.FrontEnd.Core" Version="26.11.8066" />
    <PackageReference Include="Curiosity.FrontEnd.Admin" Version="26.11.8066" />
    <PackageReference Include="Curiosity.FrontEnd" Version="26.11.8066" />
  </ItemGroup>
</Project>
